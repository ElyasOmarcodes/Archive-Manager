// د اصلي بستې ZIP دلته د پروګرام دننه ځای نیسي.
1 RCDATA "payload.zip"

1 VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          0x4L
FILETYPE        0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "000004b0"
    BEGIN
      VALUE "CompanyName",      "Arvitch"
      VALUE "FileDescription",  "Arvitch Archive Manager"
      VALUE "FileVersion",      "1.5.0.0"
      VALUE "InternalName",     "ArchiveManager"
      VALUE "OriginalFilename", "ArchiveManager.exe"
      VALUE "ProductName",      "Arvitch Archive Manager"
      VALUE "ProductVersion",   "1.5.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0, 1200
  END
END
